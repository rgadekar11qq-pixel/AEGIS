# ── LLM Provider ──
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_PROVIDER=gemini

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Enterprise Authentication & Security ──
# 64-character random hex key for signing HMAC-SHA256 session tokens
AEGIS_SESSION_SECRET=YOUR_RANDOM_SESSION_SECRET_HERE

# Predefined Owner Account
AEGIS_OWNER_ID=owner_username
AEGIS_OWNER_PASSWORD_HASH=$2a$12$...
AEGIS_OWNER_NAME=System Administrator

# Predefined Guest Account
AEGIS_GUEST_ID=guest_username
AEGIS_GUEST_PASSWORD_HASH=$2a$12$...
AEGIS_GUEST_NAME=Clinical Evaluator
