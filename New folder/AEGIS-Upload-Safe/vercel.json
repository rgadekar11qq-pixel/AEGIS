    { "source": "/sentinel", "destination": "/api/index.js" },
    { "source": "/advocate", "destination": "/api/index.js" },
    { "source": "/vision", "destination": "/api/index.js" },
    { "source": "/scores", "destination": "/api/index.js" },
    { "source": "/vitals/(.*)", "destination": "/api/index.js" },
    { "source": "/message", "destination": "/api/index.js" },
